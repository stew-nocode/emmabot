        "jsCode": "const root = $json.body ?? $json;\nconst record = root.record ?? root;\n\nconst action =\n  root.action ??\n  (root.type === 'INSERT' ? 'create' : root.type === 'UPDATE' ? 'update' : undefined);\n\nconst idAssist = root.idAssist ?? record.id_assist;\nconst mod = root.module ?? record.Module;\nconst sousModule = root.sousModule ?? record['Sous-module'];\nconst thematique =\n  root.thematique ?? record['Thématique'] ?? record.thematique;\nconst reponse =\n  root.reponse ??\n  record['Réponses / étapes à suivre'] ??\n  record.reponse;\n\nif (!thematique || !reponse) {\n  throw new Error('Champs manquants: thématique et réponse sont requis.');\n}\n\nconst content = `Module: ${mod || ''}\nSous-module: ${sousModule || ''}\nQuestion: ${thematique}\nRéponse: ${reponse}`.trim();\n\nconst metadata = {\n  id_assist: idAssist,\n  module: mod || '',\n  sous_module: sousModule || '',\n  thematique: thematique\n};\n\nreturn [{ json: { action, idAssist, content, metadata: JSON.stringify(metadata) } }];"
      },
